{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Читай во имя твоего Господа, Который сотворил все сущее,"},{"number":6108,"numberInSurah":2,"arabic":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":"сотворил человека из сгустка крови."},{"number":6109,"numberInSurah":3,"arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Читай, ведь твой Господь - Самый великодушный."},{"number":6110,"numberInSurah":4,"arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"Он научил посредством письменной трости -"},{"number":6111,"numberInSurah":5,"arabic":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":"научил человека тому, чего тот не знал."},{"number":6112,"numberInSurah":6,"arabic":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":"Но нет! Человек преступает границы дозволенного,"},{"number":6113,"numberInSurah":7,"arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"когда ему кажется, что он ни в чем не нуждается."},{"number":6114,"numberInSurah":8,"arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Но к твоему Господу предстоит возвращение."},{"number":6115,"numberInSurah":9,"arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"Что ты думаешь о том, кто мешает"},{"number":6116,"numberInSurah":10,"arabic":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"рабу, когда тот молится?"},{"number":6117,"numberInSurah":11,"arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Что ты думаешь, а если он был на правом пути"},{"number":6118,"numberInSurah":12,"arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"или призывал к богобоязненности?"},{"number":6119,"numberInSurah":13,"arabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Что ты думаешь, а если он счел ложью истину и отвернулся?"},{"number":6120,"numberInSurah":14,"arabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Неужели он не знал, что Аллах видит его?"},{"number":6121,"numberInSurah":15,"arabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"Но нет, если он не перестанет, то Мы схватим его за хохол -"},{"number":6122,"numberInSurah":16,"arabic":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":"хохол лживый, грешный."},{"number":6123,"numberInSurah":17,"arabic":"فَلْيَدْعُ نَادِيَهُۥ","translation":"Пусть он зовет свое сборище."},{"number":6124,"numberInSurah":18,"arabic":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"Мы же позовем адских стражей!"},{"number":6125,"numberInSurah":19,"arabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху."}]}
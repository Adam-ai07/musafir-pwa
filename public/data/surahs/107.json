{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","revelationType":"Meccan","numberOfAyahs":7,"ayahs":[{"number":6198,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Видел ли ты того, кто считает ложью воздаяние?"},{"number":6199,"numberInSurah":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"Это - тот, кто гонит сироту"},{"number":6200,"numberInSurah":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"и не побуждает накормить бедняка."},{"number":6201,"numberInSurah":4,"arabic":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"Горе молящимся,"},{"number":6202,"numberInSurah":5,"arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"которые небрежны к своим намазам,"},{"number":6203,"numberInSurah":6,"arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"которые лицемерят"},{"number":6204,"numberInSurah":7,"arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"и отказывают даже в мелочи!"}]}
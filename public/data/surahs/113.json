{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","translation":"Скажи: «Прибегаю к защите Господа рассвета"},{"number":6227,"numberInSurah":2,"arabic":"مِن شَرِّ مَا خَلَقَ","translation":"от зла того, что Он сотворил,"},{"number":6228,"numberInSurah":3,"arabic":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","translation":"от зла мрака, когда он наступает,"},{"number":6229,"numberInSurah":4,"arabic":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","translation":"от зла колдуний, поплевывающих на узлы,"},{"number":6230,"numberInSurah":5,"arabic":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","translation":"от зла завистника, когда он завидует»."}]}
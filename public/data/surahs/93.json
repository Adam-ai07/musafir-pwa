{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","translation":"Клянусь утром!"},{"number":6081,"numberInSurah":2,"arabic":"وَٱلَّيْلِ إِذَا سَجَىٰ","translation":"Клянусь ночью, когда она успокаивается (или покрывается мраком)!"},{"number":6082,"numberInSurah":3,"arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","translation":"Не покинул тебя твой Господь и не возненавидел."},{"number":6083,"numberInSurah":4,"arabic":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","translation":"Воистину, будущее для тебя лучше, чем настоящее."},{"number":6084,"numberInSurah":5,"arabic":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","translation":"Господь твой непременно одарит тебя, и ты будешь удовлетворен."},{"number":6085,"numberInSurah":6,"arabic":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","translation":"Разве Он не нашел тебя сиротой и не дал тебе приют?"},{"number":6086,"numberInSurah":7,"arabic":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","translation":"Он нашел тебя заблудшим и повел прямым путем."},{"number":6087,"numberInSurah":8,"arabic":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","translation":"Он нашел тебя бедным и обогатил."},{"number":6088,"numberInSurah":9,"arabic":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","translation":"Посему не притесняй сироту!"},{"number":6089,"numberInSurah":10,"arabic":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","translation":"И не гони просящего!"},{"number":6090,"numberInSurah":11,"arabic":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","translation":"И возвещай о милости своего Господа."}]}
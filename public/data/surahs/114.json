{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6231,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Скажи: «Прибегаю к защите Господа людей,"},{"number":6232,"numberInSurah":2,"arabic":"مَلِكِ ٱلنَّاسِ","translation":"Царя людей,"},{"number":6233,"numberInSurah":3,"arabic":"إِلَٰهِ ٱلنَّاسِ","translation":"Бога людей,"},{"number":6234,"numberInSurah":4,"arabic":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,"},{"number":6235,"numberInSurah":5,"arabic":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"который наущает в груди людей"},{"number":6236,"numberInSurah":6,"arabic":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"и бывает из джиннов и людей»."}]}
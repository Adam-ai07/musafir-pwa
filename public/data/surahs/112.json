{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Скажи: «Он - Аллах Единый,"},{"number":6223,"numberInSurah":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","translation":"Аллах Самодостаточный."},{"number":6224,"numberInSurah":3,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"Он не родил и не был рожден,"},{"number":6225,"numberInSurah":4,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"и нет никого равного Ему»."}]}